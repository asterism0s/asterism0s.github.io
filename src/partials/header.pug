- var pages = ["resume", "work", "writing", "pictures", "illustrations"]

header.site-header
    a.site-header__logo(href="index.html")
        img(src="assets/icons/logo.svg" alt="Sarah Siqueira, home" width="144" height="99")

    button.menu-toggle(type="button" aria-expanded="false" aria-controls="site-nav" hidden)
        span.menu-toggle__line
        span.menu-toggle__line
        span.visually-hidden Menu

    nav.site-nav#site-nav(aria-label="Main")
        ul.site-nav__list
            each page in pages
                li
                    a.site-nav__link(href=`${page}.html` aria-current=(page === currentPage ? "page" : false))= page